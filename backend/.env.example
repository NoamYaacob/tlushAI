# TlushAI backend environment variables

# LLM provider: "mock" (default), "claude", or "openai"
LLM_PROVIDER=mock

# API keys (required only for non-mock providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# File upload limits
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_RPM=20

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Tesseract OCR language packs
TESSERACT_LANG=heb+eng

# Privacy: delete uploaded file after processing
DELETE_FILE_AFTER_PROCESSING=true
